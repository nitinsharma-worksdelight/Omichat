# ---- Runtime ----
NODE_ENV=development
PORT=4000
# Optional: the API's public address for the widget embed code. Unset, it's the address the API is reached at
# (http://localhost:4000 locally, the service's URL when deployed). Set it for a custom domain.
# PUBLIC_API_URL=https://api.example.com
# Comma-separated dashboard origins allowed by CORS
DASHBOARD_ORIGINS=http://localhost:5173
# Which proxies to believe about a visitor's IP address (X-Forwarded-For): true (default: all), false, or the proxies'
# addresses and ranges, e.g. uniquelocal (private networks) plus your CDN's published ranges. A number of hops isn't
# accepted: it can't tell a proxy from a visitor.
# TRUST_PROXY=uniquelocal

# ---- Database ----
# Local dev with zero setup: embedded Postgres (PGlite) persisted in .data/
DATABASE_URL=pglite://.data/pglite
# Production / Supabase: use the pooler connection string (transaction mode), e.g.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
AUTO_MIGRATE=true
DB_ENFORCE_RLS=true

# ---- Redis (queues, locks, streaming). Leave empty locally to run everything in one process. ----
# REDIS_URL=redis://localhost:6379
RUN_WORKERS_IN_API=true

# ---- Auth ----
AUTH_MODE=local
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (encrypts webhook/workflow secrets at rest)
ENCRYPTION_KEY=
# AUTH_MODE=supabase → verify Supabase access tokens:
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWT_SECRET=

# ---- AI (LLM) — provider and model are configuration only ----
# Switching provider or model = change these lines and restart. No code change.
LLM_PROVIDER=openai                 # openai | anthropic   (unset = placeholder replies, development only)
LLM_MODEL=                          # required: the model every bot uses unless a bot overrides it
# LLM_REASONING_EFFORT=low          # low | medium | high — set only for reasoning models
# LLM_UTILITY_MODEL=                # background summaries; defaults to LLM_MODEL
# LLM_UTILITY_REASONING_EFFORT=
# LLM_BASE_URL=                     # only for a gateway / compatible endpoint (default: the provider's official API)
# LLM_TIMEOUT_MS=120000
# AI_TURN_TIMEOUT_MS=90000          # longest one reply may take (model calls + tools); retried, then handed to a person
# AI_SUMMARY_IDLE_MINUTES=30        # recap a conversation after this long without new messages; 0 = no quiet-spell recaps (closing still recaps)
# Prices (USD per 1M tokens) for cost tracking and monthly AI budgets. Without them cost shows as $0.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_CACHED_INPUT_PER_MTOK=
# LLM_PRICE_CACHE_WRITE_PER_MTOK=   # only if your provider bills cache writes separately
LLM_PRICE_OUTPUT_PER_MTOK=
# LLM_UTILITY_PRICE_INPUT_PER_MTOK= … (same four, for LLM_UTILITY_MODEL)
# LLM_MODEL_PRICES={"other-model":{"input":1,"cachedInput":0.1,"output":4}}   # e.g. per-bot overrides
OPENAI_API_KEY=                     # used by the openai provider and by knowledge-base embeddings
ANTHROPIC_API_KEY=                  # used by the anthropic provider
# ANTHROPIC_REFUSAL_FALLBACKS=false # Anthropic-only; enable for models that support server-side fallbacks

# Embeddings for the knowledge base (without OPENAI_API_KEY a local keyword embedder is used).
# Changing the embedding model re-embeds existing documents automatically on the next start.
EMBEDDINGS_MODEL=text-embedding-3-small

# ---- Storage for uploaded knowledge files ----
STORAGE_DRIVER=local
# STORAGE_DRIVER=supabase
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=knowledge

# ---- Emails: staff notifications, and customers' booking confirmations and reminders ----
# "log" only writes emails to the server log. With Resend, EMAIL_FROM must be on a domain verified in Resend;
# customer emails use the organization's name as the sender name and each calendar's reply-to address.
EMAIL_PROVIDER=log
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Omnichannel AI <notifications@yourdomain.com>
