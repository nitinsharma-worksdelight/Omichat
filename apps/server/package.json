{
  "name": "@omni/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "chat": "tsx src/scripts/chat-cli.ts",
    "search-eval": "tsx src/scripts/search-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "bullmq": "^6.3.8",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14",
    "luxon": "^3.7.2",
    "mammoth": "^1.12.3",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "undici": "^7.30.0",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
